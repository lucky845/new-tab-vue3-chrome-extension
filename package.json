{
  "name": "new-tab-vue3-chrome-extension",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Custom new tab Chrome/Edge extension (WXT + Vue 3 + Tailwind v3 + shadcn-vue + liquidglass)",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "eslint src && vue-tsc --noEmit",
    "lint:fix": "eslint eslint.config.js --fix && vue-tsc --noEmit",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@surdeddd/liquidglass": "^0.12.0",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "sortablejs": "^1.15.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.45",
    "wxt": "^0.21.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.12.1",
    "postcss": "^8.5.32",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
}
